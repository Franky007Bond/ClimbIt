# Base URL for the ClimbIt API (no trailing slash).
# For `npm run dev`, leave unset to use the Vite proxy to http://127.0.0.1:8000,
# or set http://127.0.0.1:8000 when the API sends CORS_ALLOWED_ORIGINS for your dev origin.
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Basemap tiles (OpenStreetMap standard tiles by default)
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
