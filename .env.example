POSTGRES_USER=climbit
POSTGRES_PASSWORD=climbit
POSTGRES_DB=climbit
# Host-only tools (uv run pytest, seed, alembic from your machine). Compose API
# always connects to host `db` on the internal network, not this value.
DATABASE_URL=postgresql://climbit:climbit@127.0.0.1:5432/climbit
# Comma-separated browser origins for GET /routes from the Vite dev server
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Frontend container build (Compose): leave empty so nginx proxies API on the same origin
# VITE_API_BASE_URL=
# Read-only agent MCP (issue #62); write tools stay off unless explicitly enabled
# CLIMBIT_MCP_WRITE_ENABLED=0
MAINTAINER_SESSION_SECRET=change-me-before-production
TRIP_CAPABILITY_SECRET=change-me-before-production-trip-capability
TRIP_INACTIVITY_DAYS=90
MAINTAINER_ALLOWLIST=[{"username":"operator","password_bcrypt":"$2b$12$example.hash.replace.with.real.bcrypt"}]
WIKI_ANONYMOUS_EDIT_RATE_LIMIT_MAX=20
WIKI_ANONYMOUS_EDIT_RATE_LIMIT_WINDOW_SECONDS=3600
MAX_GPX_UPLOAD_BYTES=10485760
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_MIN_INTERVAL_SECONDS=2
# Transit: mock (default, CI/tests) or transitous (live Transitous /plan API)
TRANSIT_ADAPTER=mock
TRANSITOUS_PLAN_URL=https://api.transitous.org/api/v1/plan
TRANSIT_USER_AGENT=ClimbIt/1.0 (https://github.com/Franky007Bond/ClimbIt; alpine trip planning)
TRANSIT_HTTP_TIMEOUT_SECONDS=5
# OpenTelemetry (optional OTLP export; traces always get IDs for logs and plan responses)
OTEL_SERVICE_NAME=climbit-api
OTEL_SERVICE_VERSION=dev
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
#
# Observability profile (Grafana, Prometheus, Tempo, Loki, Collector redaction):
#   docker compose -f docker-compose.yml -f docker-compose.observability.yml --profile observability up -d
# Then set for the API container:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
CLIMBIT_ENVIRONMENT=local
# Non-production plan failure observability drill (never set in production):
# CLIMBIT_PLAN_FAILURE_DRILL=1
#
# On-call worker (observability profile — issue #61):
# ONCALL_GRAFANA_URL=http://grafana:3000
# ONCALL_GRAFANA_TOKEN=
# ONCALL_POLL_INTERVAL_SECONDS=60
# ONCALL_COOLDOWN_SECONDS=900
# ONCALL_SESSION_TIMEOUT_SECONDS=900
