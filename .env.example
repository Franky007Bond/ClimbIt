POSTGRES_USER=climbit
POSTGRES_PASSWORD=climbit
POSTGRES_DB=climbit
DATABASE_URL=postgresql://climbit:climbit@db:5432/climbit
# Comma-separated browser origins for GET /routes from the Vite dev server
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MAINTAINER_SESSION_SECRET=change-me-before-production
TRIP_CAPABILITY_SECRET=change-me-before-production-trip-capability
TRIP_INACTIVITY_DAYS=90
MAINTAINER_ALLOWLIST=[{"username":"operator","password_bcrypt":"$2b$12$example.hash.replace.with.real.bcrypt"}]
WIKI_ANONYMOUS_EDIT_RATE_LIMIT_MAX=20
WIKI_ANONYMOUS_EDIT_RATE_LIMIT_WINDOW_SECONDS=3600
# Transit: mock (default, CI/tests) or transitous (live Transitous /plan API)
TRANSIT_ADAPTER=mock
TRANSITOUS_PLAN_URL=https://api.transitous.org/api/v1/plan
TRANSIT_USER_AGENT=ClimbIt/1.0 (https://github.com/Franky007Bond/ClimbIt; alpine trip planning)
TRANSIT_HTTP_TIMEOUT_SECONDS=5
